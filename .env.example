NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server-side. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de tokens de terceros (AES-256-GCM): openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Mercado Pago OAuth (https://www.mercadopago.com.ar/developers/panel/app)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3003/api/integrations/mercadopago/callback

# Opcional: auto-login en desarrollo (solo `npm run dev`)
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Consultoría con IA (opcional): investigación de mercado y explicaciones con Claude
ANTHROPIC_API_KEY=
